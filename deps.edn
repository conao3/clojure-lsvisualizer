{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  org.clojure/clojurescript {:mvn/version "1.12.145"}
  org.clojure/tools.logging {:mvn/version "1.3.1"}
  cljsjs/react {:mvn/version "18.3.1-1"}
  cljsjs/react-dom {:mvn/version "18.3.1-1"}

  reagent/reagent {:mvn/version "2.0.1"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]}

  :fig
  {:extra-deps
   {com.bhauman/figwheel-main {:mvn/version "0.2.20"}
    com.bhauman/rebel-readline-cljs {:mvn/version "0.1.11"}
    org.slf4j/slf4j-nop {:mvn/version "2.0.20"}}
   :extra-paths ["target"]}

  :build
  {:main-opts ["-m" "figwheel.main" "-b" "dev" "-r"]}

  :test {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}}}
